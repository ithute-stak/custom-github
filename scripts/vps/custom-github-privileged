#!/usr/bin/env python3
from __future__ import annotations

import base64
import ipaddress
import os
import re
import shlex
import subprocess
import sys

MAX_COMMAND_BYTES = 48_000
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
PACKAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+:-]{0,127}$")
CRON_PATH_RE = re.compile(r"^/etc/cron\.d/custom-github-[A-Za-z0-9._-]{1,80}$")


class PolicyError(RuntimeError):
    pass


def _fail(message: str) -> None:
    raise PolicyError(message)


def _valid_user(value: str) -> bool:
    return bool(USER_RE.fullmatch(value))


def _validate_ufw(tokens: list[str]) -> bool:
    if tokens in (["ufw", "status"], ["ufw", "status", "numbered"], ["ufw", "status", "verbose"]):
        return True
    if tokens in (["ufw", "--force", "enable"], ["ufw", "disable"]):
        return True
    if len(tokens) == 4 and tokens[:3] == ["ufw", "--force", "delete"] and tokens[3].isdigit():
        return 1 <= int(tokens[3]) <= 999
    if len(tokens) < 8 or tokens[0] != "ufw" or tokens[1] not in {"allow", "deny"}:
        return False
    idx = 2
    if idx < len(tokens) and tokens[idx] == "from":
        if idx + 1 >= len(tokens):
            return False
        try:
            ipaddress.ip_network(tokens[idx + 1], strict=False)
        except ValueError:
            return False
        idx += 2
    if tokens[idx : idx + 3] != ["to", "any", "port"]:
        return False
    idx += 3
    if idx >= len(tokens) or not tokens[idx].isdigit() or not (1 <= int(tokens[idx]) <= 65535):
        return False
    idx += 1
    if tokens[idx : idx + 2] not in (["proto", "tcp"], ["proto", "udp"]):
        return False
    idx += 2
    if idx == len(tokens):
        return True
    if idx + 2 != len(tokens) or tokens[idx] != "comment":
        return False
    return 0 < len(tokens[idx + 1]) <= 100 and "\n" not in tokens[idx + 1]


def _validate_apt_segment(segment: str) -> bool:
    try:
        tokens = shlex.split(segment)
    except ValueError:
        return False
    if len(tokens) < 3 or tokens[0] != "DEBIAN_FRONTEND=noninteractive" or tokens[1] != "apt-get":
        return False
    args = tokens[2:]
    if args == ["update"] or args == ["upgrade", "-y"]:
        return True
    if not args or args[0] not in {"install", "remove"}:
        return False
    action = args.pop(0)
    if not args or args.pop(0) != "-y":
        return False
    if action == "install" and args and args[0] == "--only-upgrade":
        args.pop(0)
    if not args or args.pop(0) != "--" or not args:
        return False
    return all(PACKAGE_RE.fullmatch(pkg) for pkg in args)


def _validate_direct(command: str) -> bool:
    if " && " in command:
        segments = command.split(" && ")
        return len(segments) == 2 and all(_validate_apt_segment(segment) for segment in segments)
    if command.startswith("DEBIAN_FRONTEND=noninteractive apt-get "):
        return _validate_apt_segment(command)
    try:
        tokens = shlex.split(command)
    except ValueError:
        return False
    if not tokens:
        return False
    if tokens[0] == "ufw":
        return _validate_ufw(tokens)
    if tokens == ["shutdown", "-r", "+1", "Scheduled by Custom GitHub control plane"]:
        return True
    if len(tokens) == 5 and tokens[:4] == ["usermod", "-L", "-e", "1"]:
        return _valid_user(tokens[4])
    if len(tokens) == 4 and tokens[:3] == ["usermod", "-e", "-1"]:
        return _valid_user(tokens[3])
    if tokens[0] == "userdel":
        if len(tokens) == 2:
            return _valid_user(tokens[1])
        if len(tokens) == 3 and tokens[1] == "-r":
            return _valid_user(tokens[2])
        return False
    # Managed cron deletion generated by System Admin.
    if len(tokens) == 8 and tokens[:2] == ["test", "-f"] and tokens[3:7] == ["&&", "rm", "-f", "--"]:
        return tokens[2] == tokens[7] and CRON_PATH_RE.fullmatch(tokens[2]) is not None
    return False


def _script_has_forbidden_command(script: str) -> bool:
    forbidden = {
        "sudo", "curl", "wget", "nc", "ncat", "ssh", "scp", "rsync", "python", "python3",
        "perl", "ruby", "bash", "dash", "zsh", "systemctl", "docker", "ufw", "shutdown", "reboot",
        "mount", "umount", "dd", "mkfs", "iptables", "nft", "eval", "exec", "chattr",
    }
    if re.search(r"\brm\s+-(?:[^\n]*r|r[^\n]*)\b", script) or "rm -rf" in script:
        return True
    for match in re.finditer(r"(?:^|[\n;|&()])\s*([A-Za-z0-9_.-]+)", script):
        if match.group(1) in forbidden:
            return True
    return False


def _validate_managed_script(script: str) -> bool:
    if not script or len(script.encode("utf-8")) > MAX_COMMAND_BYTES:
        return False
    if "\x00" in script or _script_has_forbidden_command(script):
        return False

    # Linux-user creation generated by the control plane. Validate before the SSH-key branch
    # because a newly-created user may also receive an authorized_keys file in the same script.
    if "useradd " in script and "passwd -l " in script:
        if "getent passwd" not in script or not script.lstrip().startswith("set -eu"):
            return False
        useradd_lines = [line.strip() for line in script.splitlines() if line.strip().startswith("useradd ")]
        if len(useradd_lines) != 1:
            return False
        try:
            parts = shlex.split(useradd_lines[0])
        except ValueError:
            return False
        if len(parts) < 3 or not _valid_user(parts[-1]):
            return False
        if "/etc/" in script or "/root/" in script:
            return False
        return True

    # SSH-key operations are constrained to a passwd-resolved home and authorized_keys.
    if ".ssh/authorized_keys" in script:
        if "getent passwd" not in script or "$home/.ssh" not in script:
            return False
        if "/etc/" in script or "/root/" in script:
            return False
        return True

    # Managed cron files are restricted to the Custom-GitHub-owned prefix.
    if "/etc/cron.d/custom-github-" in script or "/etc/cron.d/custom-github-*" in script:
        for path in re.findall(r"/etc/cron\.d/[A-Za-z0-9.*_-]+", script):
            if path == "/etc/cron.d/custom-github-*":
                continue
            if not CRON_PATH_RE.fullmatch(path):
                return False
        other_etc = re.sub(r"/etc/cron\.d/custom-github-[A-Za-z0-9.*_-]+", "", script)
        if "/etc/" in other_etc or "/root/" in script:
            return False
        return True

    return False


def validate_command(command: str) -> None:
    if not command or len(command.encode("utf-8")) > MAX_COMMAND_BYTES or "\x00" in command:
        _fail("Command payload is invalid")
    try:
        tokens = shlex.split(command)
    except ValueError as exc:
        raise PolicyError("Command payload could not be parsed") from exc
    if len(tokens) == 3 and tokens[0] == "sh" and tokens[1] == "-c":
        if not _validate_managed_script(tokens[2]):
            _fail("Managed shell operation is outside the privilege policy")
        return
    if not _validate_direct(command):
        _fail("Operation is outside the Custom GitHub privilege policy")


def execute(command: str) -> int:
    validate_command(command)
    completed = subprocess.run(
        ["/bin/sh", "-c", command],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=3600,
        check=False,
    )
    sys.stdout.write(completed.stdout or "")
    return completed.returncode


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("custom-github-privileged must run as root", file=sys.stderr)
        return 77
    if len(argv) == 2 and argv[1] == "probe":
        print("CUSTOM_GITHUB_PRIVILEGE_READY=1")
        return 0
    if len(argv) != 3 or argv[1] != "run":
        print("usage: custom-github-privileged probe | run <base64-command>", file=sys.stderr)
        return 64
    try:
        raw = base64.b64decode(argv[2], validate=True)
        if len(raw) > MAX_COMMAND_BYTES:
            raise PolicyError("Command payload is too large")
        command = raw.decode("utf-8")
        return execute(command)
    except (ValueError, UnicodeDecodeError, PolicyError) as exc:
        print(f"DENIED: {exc}", file=sys.stderr)
        return 65
    except subprocess.TimeoutExpired:
        print("Privileged operation timed out", file=sys.stderr)
        return 124


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
